{
  "name": "image-workbench",
  "version": "0.1.6",
  "private": true,
  "description": "Geeknow ??????????",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.geeknow.imageworkbench",
    "productName": "?????",
    "artifactName": "ImageWorkbench-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "?????"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guanchenli79-bit",
        "repo": "image-workbench"
      }
    ]
  }
}
