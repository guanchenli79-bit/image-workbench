{
  "appId": "ai.geeknow.imageworkbench.admin",
  "productName": "画境使用审批管理",
  "artifactName": "ImageWorkbenchAdmin-${version}-${arch}.${ext}",
  "extraMetadata": { "main": "src/admin-main.cjs" },
  "directories": { "output": "release-admin" },
  "files": [
    "src/admin-main.cjs",
    "src/admin-preload.cjs",
    "src/admin-vault.cjs",
    "src/admin-approval-token.cjs",
    "src/license.cjs",
    "src/wallpapers.cjs",
    "src/admin-wallpapers.cjs",
    "src/network.cjs",
    "src/approval.cjs",
    "src/admin-ui/**/*",
    "assets/logo.ico",
    "assets/logo.svg",
    "package.json"
  ],
  "asar": true,
  "win": { "icon": "assets/logo.ico", "target": [{ "target": "nsis", "arch": ["x64"] }] },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "画境使用审批管理" }
}
